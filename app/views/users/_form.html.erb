<h1>新規登録</h1>

<%= link_to '一覧に戻る', users_path %>

<%= form_with(model: @user, local: true) do |form| %>
  <div class="field">
    <%= form.label :name, "名前" %>
    <%= form.text_field :name %>
  </div>

  <div class="field">
    <%= form.label :ruby, "ふりがな" %>
    <%= form.text_field :ruby %>
  </div>

  <div class="actions">
    <%= form.submit "登録" %>
  </div>
<% end %>
